# ==========================================================
#  La Casa de la Nana - Variables de entorno (plantilla)
#  Copia este archivo a .env y cambia los secretos.
# ==========================================================

# --- Entorno ---
NODE_ENV=production

# --- MongoDB (contenedor) ---
MONGO_ROOT_USER=nana_admin
MONGO_ROOT_PASSWORD=cambia_esta_contrasena
MONGO_DB_NAME=la_casa_de_la_nana
MONGO_HOST_PORT=27017
# Dentro de la red nana-network el host es "mongodb"
MONGO_URI=mongodb://nana_admin:cambia_esta_contrasena@mongodb:27017/la_casa_de_la_nana?authSource=admin

# --- Puertos expuestos al host ---
REST_PORT=4000
GRAPHQL_PORT=4001
GRPC_HOST_PORT=50051

# --- Seguridad ---
JWT_SECRET=genera_un_secreto_largo_con_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
COOKIE_NAME=nana_token
# true solo detras de HTTPS
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# --- CORS (frontend React + Vite) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Reglas de negocio ---
MAX_HABITACIONES=29
